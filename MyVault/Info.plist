<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>MyVault</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>MyVault</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- Lets iOS hand MyVault a file that lives in another app's storage (Files,
         iCloud Drive, a provider). Without this key the system treats MyVault as a
         non-document app: Files shows Copy / Share / Quick Look for the backup but
         never offers MyVault, and `application(_:open:)` is never delivered. -->
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!-- Exposes MyVault's Documents folder in the Files app, which is where a backup
         the user saves with "Save to Files" is most likely to land. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>NSFaceIDUsageDescription</key>
    <string>MyVault uses Face ID to securely unlock your private vault.</string>
    <key>NSCameraUsageDescription</key>
    <string>MyVault uses the camera to capture photos and videos directly into your encrypted vault without saving them to Apple Photos.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>MyVault uses the microphone when recording videos directly into your encrypted vault.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>MyVault needs photo library access so you can import photos and videos into your encrypted vault.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>MyVault saves exported media to your photo library when you choose to export.</string>
    <key>NSUserNotificationsUsageDescription</key>
    <string>MyVault sends local reminders for your special days. All reminders stay on-device.</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- MyVault's own backup format.

         Declaring this is what makes `.mvbackup` selectable in Files. Without an
         exported type declaration, iOS cannot resolve the `mvbackup` extension, so
         the picker shows the file greyed out (or hides it entirely) and
         `UTType(filenameExtension: "mvbackup")` returns nil.

         `public.data` is declared as the parent so the file is still treated as
         ordinary data by the system (for example when copying to a Mac), while
         `CFBundleDocumentTypes` marks it as a document this app can open, which is
         what allows the file to be tapped in Files and opened "with MyVault". -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.ktapex.myvault.backup</string>
            <key>UTTypeDescription</key>
            <string>MyVault Backup</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mvbackup</string>
                </array>
                <key>public.mime-type</key>
                <string>application/x-my-vault-backup</string>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>MyVault Backup</string>
            <!-- Editor, not Viewer: MyVault is the only app that can read this format,
                 and it both opens and writes it. "Viewer" tells iOS the app merely
                 displays the type, which weakens the association for a format the app
                 owns. -->
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.ktapex.myvault.backup</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
